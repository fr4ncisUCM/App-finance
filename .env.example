# Cadena de conexión a Postgres (en Vercel la crea automáticamente la integración de Neon)
DATABASE_URL=postgres://pulso:pulso@localhost:5432/pulso
# Secreto para firmar las sesiones. Genera uno con: openssl rand -base64 32
SESSION_SECRET=cambia-esto-por-un-secreto-largo
# Opcional: activa el «Resumen del día» y «Explícamelo fácil» con IA (https://console.anthropic.com)
ANTHROPIC_API_KEY=
